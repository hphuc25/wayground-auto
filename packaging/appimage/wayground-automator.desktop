[Desktop Entry]
Type=Application
Name=Wayground Pro Automator
Comment=Automated tests on wayground.com
Exec=WaygroundAutomator
Icon=wayground-automator
Terminal=false
StartupNotify=true
Categories=Utility;
Keywords=wayground;quizizz;test;automation;quiz;
Actions=Console;ConsoleAttach;

[Desktop Action Console]
Name=Console menu
Exec=WaygroundAutomator --cli

[Desktop Action ConsoleAttach]
Name=Attach to a running browser
Exec=WaygroundAutomator --cli --attach
